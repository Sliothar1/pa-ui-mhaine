{
 "adapter": "json-claims",
 "sources": [
  {"file": "data/claims.json", "assoc": "A_claim",
   "lists": [
    {"key": "claims", "type": "claim", "id_key": "id", "source_key": "reference", "status_key": "status", "pinned_key": "pinned"},
    {"key": "places", "type": "court", "id_key": "id", "source_key": "reference", "status_key": "status"}
   ],
   "vocabulary": {"key": "status_values", "type": "status"},
   "scalars": {"type": "ledger", "id": "claims"}},
  {"file": "data/places.json", "assoc": "A_place",
   "lists": [{"key": "places", "type": "place", "id_key": "id", "source": "data/places.json (hand-placed map positions)", "status": "interpretation"}]},
  {"file": "data/eras.json", "assoc": "A_era",
   "mapping": {"type": "era", "value_col": "ring", "source": "data/eras.json (sketched era outlines, approximate)", "status": "interpretation"}}
 ],
 "prov_status_overrides": {
  "court:UM-P04": "partly pinned",
  "court:UM-P05": "partly pinned"
 }
}
